# Copier en .env et adapter. Ne jamais committer le vrai .env.
ENVIRONMENT=development

# --- LLM (ADR-0003) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Dimensionne pour le demarrage a froid d'un Ollama local sur CPU.
LLM_TIMEOUT_S=120

# --- Embeddings (ADR-0010) ---
EMBEDDING_MODEL=ibm-granite/granite-embedding-107m-multilingual
# Revision epinglee : le seuil de pertinence est calibre sur ces poids precis.
EMBEDDING_MODEL_REVISION=d6cffd338414d6a1c1f5decfad5fec62eebc90d5
# Doit rester coherent avec le modele ci-dessus ET avec la collection Qdrant,
# creee pour cette dimension. Changer l'un impose de recreer et de re-ingerer.
EMBEDDING_DIMENSION=384

# --- Base vectorielle (ADR-0005) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aisec_docs

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_DOCUMENT_BYTES=2000000

# --- Recherche ---
RETRIEVAL_TOP_K=5
# Similarite minimale d'un extrait retenu (ADR-0010). Calibree pour le modele
# ci-dessus : en changer impose de la recalibrer.
RETRIEVAL_MIN_SCORE=0.64
