# Copier en .env et adapter. Ne jamais committer le vrai .env.
ENVIRONMENT=development

# --- LLM (ADR-0003) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Dimensionne pour le demarrage a froid d'un Ollama local sur CPU.
LLM_TIMEOUT_S=120

# --- Embeddings (ADR-0010) ---
EMBEDDING_MODEL=ibm-granite/granite-embedding-107m-multilingual
# Revision epinglee : le seuil de pertinence est calibre sur ces poids precis.
EMBEDDING_MODEL_REVISION=d6cffd338414d6a1c1f5decfad5fec62eebc90d5
# Doit rester coherent avec le modele ci-dessus ET avec la collection Qdrant,
# creee pour cette dimension. Changer l'un impose de recreer et de re-ingerer.
EMBEDDING_DIMENSION=384

# --- Base vectorielle (ADR-0005) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aisec_docs

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_DOCUMENT_BYTES=2000000

# --- Recherche ---
RETRIEVAL_TOP_K=5
# Similarite minimale d'un extrait retenu (ADR-0010). Calibree pour le modele
# ci-dessus : en changer impose de la recalibrer.
RETRIEVAL_MIN_SCORE=0.64

# --- Outil CVE / NVD (ADR-0012) ---
# Base de l'API publique du NIST. Valeur de configuration : le modele choisit
# quelle CVE consulter, jamais ou aller la chercher.
NVD_BASE_URL=https://services.nvd.nist.gov
NVD_TIMEOUT_S=10.0
# Facultative. Sans elle, le NIST limite a 5 requetes par 30 s ; avec, a 50.
# A demander sur https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Plafond de longueur d'une description reinjectee dans le prompt (SEC-10).
CVE_DESCRIPTION_MAX_CHARS=1500

# --- Choix du fournisseur de modele (ADR-0013) ---
# `ollama` (defaut) : local, gratuit, hors ligne. `hosted` : service de forme
# OpenAI. Basculer ne change aucune ligne de code metier.
LLM_PROVIDER=ollama

# --- LLM heberge (ADR-0013) ---
# Groq par defaut : palier gratuit et le plus rapide, ce qui compte pour les
# campagnes de M5. Fonctionne aussi avec OpenAI, Together, Mistral, Fireworks
# ou un vLLM local — seule cette URL change.
HOSTED_LLM_BASE_URL=https://api.groq.com/openai/v1
HOSTED_LLM_MODEL=openai/gpt-oss-120b
# Requise des que LLM_PROVIDER=hosted : la configuration refuse de se charger
# sans elle. A creer sur https://console.groq.com/keys
HOSTED_LLM_API_KEY=
HOSTED_LLM_TIMEOUT_S=60.0

# --- Observabilite (ADR-0014) ---
LOG_LEVEL=INFO
# JSON : format attendu par un agregateur de logs. Mettre a false en
# developpement pour une sortie lisible a l'oeil.
LOG_JSON=true

# --- Tracage Langfuse (ADR-0015) ---
# Desactive par defaut : la CI n'a pas d'instance, et le produit doit rester
# utilisable hors ligne. L'activer suppose d'avoir demarre la pile :
#
#   cp docker/.env.example docker/.env   # puis generer les trois secrets
#   docker compose --env-file docker/.env -f docker/docker-compose.yml \
#     up -d langfuse-web langfuse-worker
#
# Puis creer un projet sur http://localhost:3000 et coller ses deux cles ici.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
