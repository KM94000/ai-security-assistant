# Secrets d'INFRASTRUCTURE de la pile d'observabilite (ADR-0015).
#
# Pourquoi un second fichier, separe du .env applicatif :
# la configuration de l'application refuse toute variable qu'elle ne connait
# pas — c'est ainsi qu'une faute de frappe dans un `.env` fait echouer le
# demarrage au lieu de passer inapercue. Ces trois valeurs ne concernent que
# docker compose, jamais l'application.
#
# A generer une fois, sur votre poste :
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Trois valeurs distinctes. Les conteneurs refusent de demarrer si elles sont
# absentes : mieux vaut un echec net qu'une instance chiffree avec une valeur
# d'exemple que personne n'aurait remplacee.

LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
